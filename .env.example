# Copy to .env. With USE_LLM=0 (default) the agent is fully deterministic and needs no keys.
USE_LLM=0

# Required only when USE_LLM=1.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Small, fast model used only when keyword routing is ambiguous.
ROUTER_MODEL=claude-haiku-5-5

# Optional: enables scripts/eval_langsmith.py and LangSmith tracing.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=policy-grounded-agent
