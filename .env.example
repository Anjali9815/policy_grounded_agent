# Copy to .env. With USE_LLM=0 (default) the agent is fully deterministic and needs no keys.
USE_LLM=0

# LLM backend when USE_LLM=1: anthropic or groq.
LLM_PROVIDER=anthropic

# Models. RESPONDER_MODEL runs the intent and responder agents; ROUTER_MODEL is the small,
# fast model used only when keyword routing is ambiguous. Anthropic defaults:
# claude-opus-5-5 and claude-haiku-5-5. Groq has no defaults, so set both.
RESPONDER_MODEL=
ROUTER_MODEL=

# Credentials for the chosen provider.
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# Optional: enables scripts/eval_langsmith.py and LangSmith tracing.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=policy-grounded-agent
